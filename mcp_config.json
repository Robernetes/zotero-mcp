{
  "mcpServers": {
    "zotero": {
      "command": "node",
      "args": ["./src/server.js"],
      "env": {
        "ZOTERO_API_URL": "${ZOTERO_API_URL}",
        "ZOTERO_DEFAULT_STYLE": "${ZOTERO_DEFAULT_STYLE}",
        "ZOTERO_LOCALE": "${ZOTERO_LOCALE}",
        "ZOTERO_MCP_BACKUP": "${ZOTERO_MCP_BACKUP}",
        "OPENALEX_API_KEY": "${OPENALEX_API_KEY}",
        "ZOTERO_MCP_CONTACT_EMAIL": "${ZOTERO_MCP_CONTACT_EMAIL}",
        "ZOTERO_MCP_ALLOWED_DIRS": "${ZOTERO_MCP_ALLOWED_DIRS}"
      }
    }
  }
}
